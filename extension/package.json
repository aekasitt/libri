{
  "author": "Sitt Guruvanich <aekazitt+github@gmail.com>",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@crxjs/vite-plugin": "^2.3.0",
    "@types/chrome": "^0.0.246",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "vite-plugin-static-copy": "^0.17.1"
  },
  "engines": {
    "node": ">=18",
    "yarn": ">=6.0.0-rc.15"
  },
  "keywords": [],
  "license": "MIT",
  "name": "extension",
  "packageManager": "yarn@6.0.0-rc.15",
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "build:isolate": "tsc && vite build",
    "build:style": "tailwindcss -i ./style.css -o dist/assets/dictation-web/style.css --minify",
    "check": "biome check --write {manifest,src/**/*,vite.config}.ts",
    "dev": "tsc && vite build --mode development",
    "dev:isolate": "tsc && vite build --mode development",
    "fmt": "biome format --write {manifest,src/**/*,vite.config}.ts",
    "postbuild": "tailwindcss -i ./style.css -o dist/assets/dictation-web/style.css --minify",
    "prebuild": "cd ../core && trunk build --release",
    "predev": "cd ../core && trunk build --features development"
  },
  "type": "module",
  "version": "0.0.0"
}
